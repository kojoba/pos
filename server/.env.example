PORT=4000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
ADMIN_USERNAME=manager
ADMIN_NAME=Restaurant Manager
ADMIN_PASSWORD=ChangeMe123!
CLIENT_ORIGIN=http://localhost:5173

# Add a Paystack test secret key (sk_test_...) for development. Keep it server-side.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret_key

# Delivery verification emails via Gmail SMTP. Use a Google App Password, not your Gmail password.
GMAIL_USER=your.gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SMTP_PORT=465
EMAIL_FROM_NAME=Daddy's Pizza
DELIVERY_CODE_SECRET=replace-with-a-different-long-random-secret
FEEDBACK_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Customer broadcasts: on Render use Resend's HTTPS API for email; verify the sender domain first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PUBLIC_BASE_URL=http://localhost:5173
CUSTOMER_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret

# Customer SMS broadcasts through Hubtel. Sender ID must be approved by Hubtel.
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=
